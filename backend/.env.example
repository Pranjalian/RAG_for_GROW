# ─── Database ─────────────────────────────────────────────────────
# For Docker Compose (PostgreSQL):
DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@localhost:5432/rag_grow

# For local dev (SQLite — no Docker required):
# DATABASE_URL=sqlite+aiosqlite:///./data/rag_grow.db

# ─── ChromaDB & Snapshots ─────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chromadb
SNAPSHOT_DIR=./data/snapshots

# ─── GROK LLM ─────────────────────────────────────────────────────
GROK_API_KEY=<your-grok-api-key>
# GROK API base URL (OpenAI-compatible endpoint)
GROK_API_BASE_URL=https://api.x.ai/v1
GROK_MODEL_NAME=grok-beta

# ─── Embedding Model ──────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── JWT Auth ─────────────────────────────────────────────────────
# Generate a secure random string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<generate-a-secure-random-secret>
JWT_EXPIRY_HOURS=1

# ─── Scraping ─────────────────────────────────────────────────────
SCRAPE_INTERVAL_MINUTES=15
SCRAPE_TIMEOUT_SECONDS=30
SCRAPE_MAX_CONCURRENT=5

# ─── Admin Seed Credentials ───────────────────────────────────────
# IMPORTANT: Change these in production!
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
